# Optional — easiest way to power Sarah (AI receptionist).
# Set GEMINI_API_KEY in the Vercel dashboard (Project → Settings →
# Environment Variables) instead of committing it here.
GEMINI_API_KEY=

# Optional — only needed if the Gemini key is stored in Firestore
# (Admin → Settings) instead of as an env var. Paste the whole JSON
# of a Firebase service-account key as ONE line. Never commit this.
FIREBASE_SERVICE_ACCOUNT=
